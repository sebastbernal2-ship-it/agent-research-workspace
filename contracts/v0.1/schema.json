{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sebastbernal2-ship-it/agent-research-workspace/contracts/v0.1/schema.json",
  "title": "Project-first AI workspace canonical contracts v0.1",
  "description": "Language-neutral interchange records. Event records are authoritative; other records are projections or immutable references. No secrets or native runtime state belong here.",
  "oneOf": [
    { "$ref": "#/$defs/project" },
    { "$ref": "#/$defs/capabilityGrant" },
    { "$ref": "#/$defs/workItem" },
    { "$ref": "#/$defs/agentRun" },
    { "$ref": "#/$defs/question" },
    { "$ref": "#/$defs/artifact" },
    { "$ref": "#/$defs/evidence" },
    { "$ref": "#/$defs/event" }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timestamp": { "type": "string", "format": "date-time", "maxLength": 40 },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorType", "actorId", "role"],
      "properties": {
        "actorType": { "enum": ["human", "agent", "system"] },
        "actorId": { "$ref": "#/$defs/id" },
        "role": { "enum": ["user", "vp", "orchestrator", "specialist", "reviewer", "worker", "system"] }
      }
    },
    "refList": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/id" }
    },
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 128,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordType", "schemaVersion", "projectId", "revision", "name", "status", "charter", "createdAt", "updatedAt"],
      "properties": {
        "recordType": { "const": "project" },
        "schemaVersion": { "const": "0.1" },
        "projectId": { "$ref": "#/$defs/id" },
        "revision": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "status": { "enum": ["active", "paused", "archived"] },
        "charter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["revision", "goals", "nonGoals", "acceptanceCriteria"],
          "properties": {
            "revision": { "type": "integer", "minimum": 1 },
            "goals": { "$ref": "#/$defs/stringList" },
            "nonGoals": { "$ref": "#/$defs/stringList" },
            "acceptanceCriteria": { "$ref": "#/$defs/stringList" },
            "policyRef": { "$ref": "#/$defs/id" }
          }
        },
        "createdBy": { "$ref": "#/$defs/actor" },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "updatedAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxInputTokens": { "type": "integer", "minimum": 0 },
        "maxOutputTokens": { "type": "integer", "minimum": 0 },
        "maxCostUsd": { "type": "number", "minimum": 0 },
        "deadline": { "$ref": "#/$defs/timestamp" }
      }
    },
    "workItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordType", "schemaVersion", "projectId", "workId", "revision", "title", "objective", "workType", "status", "owner", "dependsOn", "capabilityGrantIds", "acceptanceCriteria", "createdAt", "updatedAt"],
      "properties": {
        "recordType": { "const": "work_item" },
        "schemaVersion": { "const": "0.1" },
        "projectId": { "$ref": "#/$defs/id" },
        "workId": { "$ref": "#/$defs/id" },
        "revision": { "type": "integer", "minimum": 1 },
        "parentWorkId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "objective": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "workType": { "enum": ["research", "analysis", "planning", "writing", "review", "implementation", "operations", "other"] },
        "status": { "enum": ["proposed", "ready", "running", "blocked", "waiting_human", "verifying", "completed", "failed", "cancelled"] },
        "owner": { "$ref": "#/$defs/actor" },
        "dependsOn": { "$ref": "#/$defs/refList" },
        "capabilityGrantIds": { "$ref": "#/$defs/refList" },
        "acceptanceCriteria": { "$ref": "#/$defs/stringList" },
        "budget": { "$ref": "#/$defs/budget" },
        "createdBy": { "$ref": "#/$defs/actor" },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "updatedAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "agentRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordType", "schemaVersion", "projectId", "runId", "workId", "agent", "adapter", "status", "contextHash", "capabilityGrantIds", "startedAt"],
      "properties": {
        "recordType": { "const": "agent_run" },
        "schemaVersion": { "const": "0.1" },
        "projectId": { "$ref": "#/$defs/id" },
        "runId": { "$ref": "#/$defs/id" },
        "workId": { "$ref": "#/$defs/id" },
        "agent": { "$ref": "#/$defs/actor" },
        "adapter": { "$ref": "#/$defs/adapter" },
        "providerClass": { "type": "string", "maxLength": 100 },
        "modelClass": { "type": "string", "maxLength": 100 },
        "status": { "enum": ["queued", "running", "waiting_human", "succeeded", "failed", "cancelled", "interrupted"] },
        "contextHash": { "$ref": "#/$defs/sha256" },
        "capabilityGrantIds": { "$ref": "#/$defs/refList" },
        "idempotencyKey": { "$ref": "#/$defs/id" },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "inputTokens": { "type": "integer", "minimum": 0 },
            "outputTokens": { "type": "integer", "minimum": 0 },
            "toolCalls": { "type": "integer", "minimum": 0 },
            "costUsd": { "type": "number", "minimum": 0 }
          }
        },
        "outputArtifactIds": { "$ref": "#/$defs/refList" },
        "startedAt": { "$ref": "#/$defs/timestamp" },
        "finishedAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordType", "schemaVersion", "projectId", "questionId", "questionType", "priority", "blocking", "requestedBy", "workIds", "questionText", "impact", "options", "status", "createdAt"],
      "properties": {
        "recordType": { "const": "human_question" },
        "schemaVersion": { "const": "0.1" },
        "projectId": { "$ref": "#/$defs/id" },
        "questionId": { "$ref": "#/$defs/id" },
        "questionType": { "enum": ["clarification", "approval", "permission", "budget", "tradeoff", "decision"] },
        "priority": { "enum": ["low", "normal", "high", "urgent"] },
        "blocking": { "type": "boolean" },
        "requestedBy": { "$ref": "#/$defs/actor" },
        "workIds": { "$ref": "#/$defs/refList" },
        "runId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "questionText": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "impact": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "options": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "object", "additionalProperties": false, "required": ["optionId", "label"], "properties": { "optionId": { "$ref": "#/$defs/id" }, "label": { "type": "string", "minLength": 1, "maxLength": 500 }, "consequence": { "type": "string", "maxLength": 2000 } } }
        },
        "status": { "enum": ["open", "answered", "rejected", "cancelled", "expired", "superseded"] },
        "closedBy": { "$ref": "#/$defs/actor" },
        "closedAt": { "$ref": "#/$defs/timestamp" },
        "resolutionReason": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "supersededByQuestionId": { "$ref": "#/$defs/id" },
        "answer": {
          "anyOf": [
            { "type": "null" },
            { "type": "object", "additionalProperties": false, "required": ["text", "answeredBy", "answeredAt"], "properties": { "text": { "type": "string", "minLength": 1, "maxLength": 10000 }, "selectedOptionId": { "$ref": "#/$defs/id" }, "answeredBy": { "$ref": "#/$defs/actor" }, "answeredAt": { "$ref": "#/$defs/timestamp" }, "resumedWorkIds": { "$ref": "#/$defs/refList" } } }
          ]
        },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "dueAt": { "$ref": "#/$defs/timestamp" }
      },
      "allOf": [
        { "if": { "properties": { "status": { "const": "answered" } }, "required": ["status"] }, "then": { "properties": { "answer": { "type": "object" } }, "required": ["answer"] } },
        { "if": { "properties": { "status": { "enum": ["open", "rejected", "cancelled", "expired", "superseded"] } }, "required": ["status"] }, "then": { "properties": { "answer": { "type": "null" } } } },
        { "if": { "properties": { "status": { "enum": ["rejected", "cancelled", "expired", "superseded"] } }, "required": ["status"] }, "then": { "required": ["closedBy", "closedAt", "resolutionReason"] } },
        { "if": { "properties": { "status": { "const": "superseded" } }, "required": ["status"] }, "then": { "required": ["supersededByQuestionId"] } }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordType", "schemaVersion", "projectId", "artifactId", "workId", "name", "mediaType", "sha256", "byteSize", "storageRef", "createdBy", "createdAt"],
      "properties": {
        "recordType": { "const": "artifact" },
        "schemaVersion": { "const": "0.1" },
        "projectId": { "$ref": "#/$defs/id" },
        "artifactId": { "$ref": "#/$defs/id" },
        "workId": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "mediaType": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.+-]*/[a-z0-9][a-z0-9.+-]*$", "maxLength": 127 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byteSize": { "type": "integer", "minimum": 0 },
        "storageRef": { "$ref": "#/$defs/id" },
        "createdBy": { "$ref": "#/$defs/actor" },
        "runId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "reviewStatus": { "enum": ["unreviewed", "reviewed", "accepted", "rejected"] }
      }
    },
    "capabilityGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordType", "schemaVersion", "projectId", "grantId", "revision", "subject", "workIds", "capability", "resourceIds", "grantedBy", "createdAt", "expiresAt", "status"],
      "properties": {
        "recordType": { "const": "capability_grant" },
        "schemaVersion": { "const": "0.1" },
        "projectId": { "$ref": "#/$defs/id" },
        "grantId": { "$ref": "#/$defs/id" },
        "revision": { "type": "integer", "minimum": 1 },
        "subject": { "$ref": "#/$defs/actor" },
        "workIds": { "$ref": "#/$defs/refList", "minItems": 1 },
        "capability": { "enum": ["artifact.read", "artifact.write", "source.fetch", "tool.execute", "network.request", "filesystem.read", "filesystem.write", "provider.call", "worker.delegate"] },
        "resourceIds": { "$ref": "#/$defs/refList", "minItems": 1 },
        "grantedBy": { "$ref": "#/$defs/actor" },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "expiresAt": { "$ref": "#/$defs/timestamp" },
        "status": { "enum": ["active", "revoked"] },
        "revokedBy": { "$ref": "#/$defs/actor" },
        "revokedAt": { "$ref": "#/$defs/timestamp" },
        "revokeReason": { "type": "string", "minLength": 1, "maxLength": 2000 }
      },
      "allOf": [
        { "if": { "properties": { "status": { "const": "revoked" } }, "required": ["status"] }, "then": { "required": ["revokedBy", "revokedAt", "revokeReason"] } }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordType", "schemaVersion", "projectId", "evidenceId", "workId", "claimText", "stance", "source", "createdBy", "createdAt"],
      "properties": {
        "recordType": { "const": "evidence" },
        "schemaVersion": { "const": "0.1" },
        "projectId": { "$ref": "#/$defs/id" },
        "evidenceId": { "$ref": "#/$defs/id" },
        "workId": { "$ref": "#/$defs/id" },
        "claimText": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "stance": { "enum": ["supports", "contradicts", "qualifies", "background"] },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["uri", "title", "retrievedAt"],
          "properties": {
            "uri": { "type": "string", "format": "uri", "maxLength": 2048 },
            "title": { "type": "string", "minLength": 1, "maxLength": 500 },
            "publisher": { "type": "string", "maxLength": 300 },
            "publishedAt": { "$ref": "#/$defs/timestamp" },
            "retrievedAt": { "$ref": "#/$defs/timestamp" },
            "contentHash": { "$ref": "#/$defs/sha256" },
            "locator": { "type": "string", "maxLength": 1000 },
            "excerptRef": { "$ref": "#/$defs/id" }
          }
        },
        "createdBy": { "$ref": "#/$defs/actor" },
        "runId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "reviewStatus": { "enum": ["unreviewed", "corroborated", "contested", "human_verified"] }
      }
    },
    "eventPayload": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["name", "charterHash", "recordHash"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 200 }, "charterHash": { "$ref": "#/$defs/sha256" }, "recordHash": { "$ref": "#/$defs/sha256" } } },
        { "type": "object", "additionalProperties": false, "required": ["charterRevision", "charterHash", "recordHash"], "properties": { "charterRevision": { "type": "integer", "minimum": 1 }, "charterHash": { "$ref": "#/$defs/sha256" }, "recordHash": { "$ref": "#/$defs/sha256" } } },
        { "type": "object", "additionalProperties": false, "required": ["workId", "title", "objective", "owner", "recordHash"], "properties": { "workId": { "$ref": "#/$defs/id" }, "title": { "type": "string", "minLength": 1, "maxLength": 200 }, "objective": { "type": "string", "minLength": 1, "maxLength": 10000 }, "owner": { "$ref": "#/$defs/actor" }, "recordHash": { "$ref": "#/$defs/sha256" }, "parentWorkId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] } } },
        { "type": "object", "additionalProperties": false, "required": ["workId", "from", "to", "recordHash"], "properties": { "workId": { "$ref": "#/$defs/id" }, "from": { "enum": ["proposed", "ready", "running", "blocked", "waiting_human", "verifying", "completed", "failed", "cancelled"] }, "to": { "enum": ["proposed", "ready", "running", "blocked", "waiting_human", "verifying", "completed", "failed", "cancelled"] }, "recordHash": { "$ref": "#/$defs/sha256" }, "reason": { "type": "string", "maxLength": 2000 } } },
        { "type": "object", "additionalProperties": false, "required": ["workId", "fromRevision", "toRevision", "recordHash"], "properties": { "workId": { "$ref": "#/$defs/id" }, "fromRevision": { "type": "integer", "minimum": 1 }, "toRevision": { "type": "integer", "minimum": 2 }, "recordHash": { "$ref": "#/$defs/sha256" } } },
        { "type": "object", "additionalProperties": false, "required": ["workId", "threadId", "messageType", "contentRef", "contentHash", "visibleTo"], "properties": { "workId": { "$ref": "#/$defs/id" }, "threadId": { "$ref": "#/$defs/id" }, "messageType": { "enum": ["proposal", "question", "challenge", "evidence", "revision", "decision", "status"] }, "contentRef": { "$ref": "#/$defs/id" }, "contentHash": { "$ref": "#/$defs/sha256" }, "artifactIds": { "$ref": "#/$defs/refList" }, "evidenceIds": { "$ref": "#/$defs/refList" }, "visibleTo": { "$ref": "#/$defs/refList" } } },
        { "type": "object", "additionalProperties": false, "required": ["runId", "workId", "adapter", "contextHash", "capabilityGrantIds", "recordHash"], "properties": { "runId": { "$ref": "#/$defs/id" }, "workId": { "$ref": "#/$defs/id" }, "adapter": { "$ref": "#/$defs/adapter" }, "contextHash": { "$ref": "#/$defs/sha256" }, "capabilityGrantIds": { "$ref": "#/$defs/refList" }, "recordHash": { "$ref": "#/$defs/sha256" } } },
        { "type": "object", "additionalProperties": false, "required": ["runId", "terminalStatus", "recordHash"], "properties": { "runId": { "$ref": "#/$defs/id" }, "terminalStatus": { "enum": ["succeeded", "failed", "cancelled", "interrupted"] }, "artifactIds": { "$ref": "#/$defs/refList" }, "evidenceIds": { "$ref": "#/$defs/refList" }, "recordHash": { "$ref": "#/$defs/sha256" }, "summaryRef": { "$ref": "#/$defs/id" } } },
        { "type": "object", "additionalProperties": false, "required": ["questionId", "questionType", "priority", "blocking", "workIds", "questionRef", "recordHash"], "properties": { "questionId": { "$ref": "#/$defs/id" }, "questionType": { "enum": ["clarification", "approval", "permission", "budget", "tradeoff", "decision"] }, "priority": { "enum": ["low", "normal", "high", "urgent"] }, "blocking": { "type": "boolean" }, "workIds": { "$ref": "#/$defs/refList" }, "questionRef": { "$ref": "#/$defs/id" }, "recordHash": { "$ref": "#/$defs/sha256" } } },
        { "type": "object", "additionalProperties": false, "required": ["questionId", "answerRef", "resumedWorkIds", "recordHash"], "properties": { "questionId": { "$ref": "#/$defs/id" }, "answerRef": { "$ref": "#/$defs/id" }, "resumedWorkIds": { "$ref": "#/$defs/refList" }, "recordHash": { "$ref": "#/$defs/sha256" } } },
        { "type": "object", "additionalProperties": false, "required": ["questionId", "from", "to", "affectedWorkIds", "resolutionReason", "recordHash"], "properties": { "questionId": { "$ref": "#/$defs/id" }, "from": { "const": "open" }, "to": { "enum": ["rejected", "cancelled", "expired", "superseded"] }, "affectedWorkIds": { "$ref": "#/$defs/refList" }, "resolutionReason": { "type": "string", "minLength": 1, "maxLength": 4000 }, "supersededByQuestionId": { "$ref": "#/$defs/id" }, "recordHash": { "$ref": "#/$defs/sha256" } } },
        { "type": "object", "additionalProperties": false, "required": ["artifactId", "workId", "sha256", "recordHash"], "properties": { "artifactId": { "$ref": "#/$defs/id" }, "workId": { "$ref": "#/$defs/id" }, "sha256": { "$ref": "#/$defs/sha256" }, "recordHash": { "$ref": "#/$defs/sha256" } } },
        { "type": "object", "additionalProperties": false, "required": ["evidenceId", "workId", "stance", "sourceHash", "recordHash"], "properties": { "evidenceId": { "$ref": "#/$defs/id" }, "workId": { "$ref": "#/$defs/id" }, "stance": { "enum": ["supports", "contradicts", "qualifies", "background"] }, "sourceHash": { "$ref": "#/$defs/sha256" }, "recordHash": { "$ref": "#/$defs/sha256" } } },
        { "type": "object", "additionalProperties": false, "required": ["grantId", "workIds", "capability", "recordHash"], "properties": { "grantId": { "$ref": "#/$defs/id" }, "workIds": { "$ref": "#/$defs/refList" }, "capability": { "enum": ["artifact.read", "artifact.write", "source.fetch", "tool.execute", "network.request", "filesystem.read", "filesystem.write", "provider.call", "worker.delegate"] }, "recordHash": { "$ref": "#/$defs/sha256" } } },
        { "type": "object", "additionalProperties": false, "required": ["grantId", "recordHash", "revokeReason"], "properties": { "grantId": { "$ref": "#/$defs/id" }, "recordHash": { "$ref": "#/$defs/sha256" }, "revokeReason": { "type": "string", "minLength": 1, "maxLength": 2000 } } }
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordType", "schemaVersion", "eventId", "projectId", "sequence", "eventType", "actor", "occurredAt", "idempotencyKey", "payload"],
      "properties": {
        "recordType": { "const": "event" },
        "schemaVersion": { "const": "0.1" },
        "eventId": { "$ref": "#/$defs/id" },
        "projectId": { "$ref": "#/$defs/id" },
        "sequence": { "type": "integer", "minimum": 1 },
        "eventType": { "enum": ["project.created", "project.charter_revised", "work.created", "work.status_changed", "work.revised", "discussion.message_added", "run.started", "run.finished", "human.question_opened", "human.question_answered", "human.question_closed", "capability.granted", "capability.revoked", "artifact.registered", "evidence.registered"] },
        "actor": { "$ref": "#/$defs/actor" },
        "occurredAt": { "$ref": "#/$defs/timestamp" },
        "causationId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "correlationId": { "$ref": "#/$defs/id" },
        "idempotencyKey": { "$ref": "#/$defs/id" },
        "payload": { "$ref": "#/$defs/eventPayload" }
      },
      "allOf": [
        { "if": { "properties": { "eventType": { "const": "project.created" } }, "required": ["eventType"] }, "then": { "properties": { "payload": { "required": ["name", "charterHash", "recordHash"] } } } },
        { "if": { "properties": { "eventType": { "const": "project.charter_revised" } }, "required": ["eventType"] }, "then": { "properties": { "payload": { "required": ["charterRevision", "charterHash", "recordHash"] } } } },
        { "if": { "properties": { "eventType": { "const": "work.created" } }, "required": ["eventType"] }, "then": { "properties": { "payload": { "required": ["workId", "title", "objective", "owner", "recordHash"] } } } },
        { "if": { "properties": { "eventType": { "const": "work.status_changed" } }, "required": ["eventType"] }, "then": { "properties": { "payload": { "required": ["workId", "from", "to", "recordHash"] } } } },
        { "if": { "properties": { "eventType": { "const": "work.revised" } }, "required": ["eventType"] }, "then": { "properties": { "payload": { "required": ["workId", "fromRevision", "toRevision", "recordHash"] } } } },
        { "if": { "properties": { "eventType": { "const": "discussion.message_added" } }, "required": ["eventType"] }, "then": { "properties": { "payload": { "required": ["workId", "threadId", "messageType", "contentRef", "contentHash", "visibleTo"] } } } },
        { "if": { "properties": { "eventType": { "const": "run.started" } }, "required": ["eventType"] }, "then": { "properties": { "payload": { "required": ["runId", "workId", "adapter", "contextHash", "capabilityGrantIds", "recordHash"] } } } },
        { "if": { "properties": { "eventType": { "const": "run.finished" } }, "required": ["eventType"] }, "then": { "properties": { "payload": { "required": ["runId", "terminalStatus", "recordHash"] } } } },
        { "if": { "properties": { "eventType": { "const": "human.question_opened" } }, "required": ["eventType"] }, "then": { "properties": { "payload": { "required": ["questionId", "questionType", "priority", "blocking", "workIds", "questionRef", "recordHash"] } } } },
        { "if": { "properties": { "eventType": { "const": "human.question_answered" } }, "required": ["eventType"] }, "then": { "properties": { "payload": { "required": ["questionId", "answerRef", "resumedWorkIds", "recordHash"] } } } },
        { "if": { "properties": { "eventType": { "const": "human.question_closed" } }, "required": ["eventType"] }, "then": { "properties": { "payload": { "required": ["questionId", "from", "to", "affectedWorkIds", "recordHash"] } } } },
        { "if": { "properties": { "eventType": { "const": "capability.granted" } }, "required": ["eventType"] }, "then": { "properties": { "payload": { "required": ["grantId", "workIds", "capability", "recordHash"] } } } },
        { "if": { "properties": { "eventType": { "const": "capability.revoked" } }, "required": ["eventType"] }, "then": { "properties": { "payload": { "required": ["grantId", "recordHash", "revokeReason"] } } } },
        { "if": { "properties": { "eventType": { "const": "artifact.registered" } }, "required": ["eventType"] }, "then": { "properties": { "payload": { "required": ["artifactId", "workId", "sha256", "recordHash"] } } } },
        { "if": { "properties": { "eventType": { "const": "evidence.registered" } }, "required": ["eventType"] }, "then": { "properties": { "payload": { "required": ["evidenceId", "workId", "stance", "sourceHash", "recordHash"] } } } }
      ]
    }
  }
}
